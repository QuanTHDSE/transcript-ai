POSTGRES_DB=transcripto
POSTGRES_USER=transcripto
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://transcripto:change-me@postgres:5432/transcripto
REDIS_URL=redis://redis:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000
WORKER_CONCURRENCY=1
WORKER_MEMORY_LIMIT=2g
WORKER_CPUS=2
WHISPER_CPU_THREADS=2
WHISPER_MODEL=tiny
JOB_MAX_ATTEMPTS=3
JOB_TIME_LIMIT=1800
MAX_UPLOAD_BYTES=104857600
MAX_TEMPLATE_BYTES=10485760
UPLOAD_DIR=/app/storage/uploads
# Server-controlled module:factory adapters implementing TextEvaluator/AudioEvaluator.
# Empty means explicitly UNAVAILABLE; no placeholder scores are generated.
SPEAKING_TEXT_PROVIDER=
SPEAKING_AUDIO_PROVIDER=app.speaking_audio:create_evaluator
SPEAKING_AUDIO_MAX_SECONDS=600
SPEAKING_VAD_THRESHOLD=0.5
SPEAKING_LONG_PAUSE_MS=1500
# To enable the text adapter, set SPEAKING_TEXT_PROVIDER=app.speaking_text:create_evaluator
# Endpoint must support the chat-completions JSON response contract.
SPEAKING_LLM_URL=
SPEAKING_LLM_API_KEY=
SPEAKING_LLM_MODEL=
SPEAKING_LLM_CHUNK_CHARS=4000
SPEAKING_LLM_TEMPERATURE=0.2
